                                   (tc/select-rows #(= "Parking Prohibited" (% :violation_desc-condensed))))})
      (pj/lay-value-bar :violation_desc-condensed :n
                        {:color "grey"
                         :data (-> sorted-data
                                   (tc/select-rows #(not (= "Parking Prohibited" (% :violation_desc-condensed)))))})

    ;;   (pj/lay-text {:text :text
    ;;                 :data {:violation_desc-condensed ["Bus Only Zone"]
    ;;                        :n [150000]
    ;;                        :text ["There appears to be different tiers of violations"]}})

    ;;   (pj/lay-text {:text :text
    ;;                 :data {:violation_desc-condensed ["Sidewalk"]
    ;;                        :n [150000]
    ;;                        :text ["based upon the number of tickets issued"]}})

      (pj/lay-line {:data {:violation_desc-condensed ["Bus Only Zone" "Parking Prohibited"]
                           :n [300000 150000]}})

      (pj/lay-line {:data {:violation_desc-condensed ["Bus Only Zone" "Bus Only Zone"]
                           :n [150000 420000]}
                    :color "grey"
                    :size 2})
      (pj/lay-line {:data {:violation_desc-condensed ["Passenger Loading Zone" "Passenger Loading Zone"]
                           :n [150000 420000]}
                    :color "grey"
                    :size 2})
      (pj/lay-line {:data {:violation_desc-condensed ["Bus Only Zone" "Passenger Loading Zone"]
                           :n [150000 150000]}
                    :color "grey"
                    :size 2})
      (pj/lay-line {:data {:violation_desc-condensed ["Bus Only Zone" "Passenger Loading Zone"]
                           :n [420000 420000]}
                    :color "grey"
                    :size 2})
      

      (pj/lay-label {:text :n
                     :nudge-y 10000
                     :color "black"})
      (pj/scale :y {:breaks ticks
                    :labels labels})
      (pj/scale :x {:domain all-values})

      (pj/coord :flip)
      (pj/options {:title "Number of tickets issued by Violation Description"
                   :x-label "Violation Description"
                   :y-label "Number of tickets issued"
                   :palette ["grey" "red"]})
      (pj/pose->draft)
      (pj/draft->membrane)
      (update :drawables
      
              (fn [uuuu]
                (let [drawables
                      [(ui/translate 300 250
                                     (ui/with-color [0.0 0.0 0.0]
                                       (ui/label "There appears to be different tiers of violations"
                                                 (ui/font nil 8))))
                       (ui/translate 300 260
                                     (ui/with-color [0.0 0.0 0.0]
                                       (ui/label "based upon the number of tickets issued"
                                                 (ui/font nil 8))))
                       (ui/translate 300 280
                                     (ui/with-color [0.0 0.0 0.0]
                                       (ui/label "'Meter Expired' is in a tier of its own.'"
                                                 (ui/font nil 8))))
                       (ui/translate 300 290
                                     (ui/with-color [0.0 0.0 0.0]
                                       (ui/label "'Parking Prohibited' ends the next tier."
                                                 (ui/font nil 8))))
                       (ui/translate 0 0
                        (ui/with-color [0.0 0.0 0.0]
                          (ui/with-stroke-width 10
                            (ui/path [300 250] [250 200]))))

                       
                       ]]
                  (concat uuuu drawables))))
      (pj/membrane->plot :svg {})

      
      

      
      )) "/mnt/sdb3/sources/plotje/notebooks/philadelfia_parking.clj" {:ide :calva}))

