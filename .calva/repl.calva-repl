(defn note-lines [lines top-x-px top-y-px]
  (conj
   (map-indexed
    #(note-line %2 (* %1 9) top-x-px top-y-px)
    lines)
   (->>
    (ui/path [50 50] [50 100] [100 100] [100 50] [50 50])
    (ui/with-color [1 0 0])
    (ui/with-style :membrane.ui/style-stroke)
    ))
  )
