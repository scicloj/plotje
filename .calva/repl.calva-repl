      (pj/lay-value-bar :violation_desc-condensed :n
                        {:color "red"
                         :data (-> sorted-data
                                   (tc/select-rows #(= "Parking Prohibited" (% :violation_desc-condensed))))})
      (pj/lay-value-bar :violation_desc-condensed :n
                        {:color "lightgrey"
                         :data (-> sorted-data
                                   (tc/select-rows #(not (= "Parking Prohibited" (% :violation_desc-condensed)))))})

      (pj/lay-line {:data {:violation_desc-condensed ["Bus Only Zone" "Parking Prohibited"]
                           :n [300000 150000]}})

      (pj/lay-line {:data {:violation_desc-condensed ["Bus Only Zone" "Bus Only Zone"]
                           :n [150000 380000]}
                    :color "grey"
                    :size 2})
      (pj/lay-line {:data {:violation_desc-condensed ["Passenger Loading Zone" "Passenger Loading Zone"]
                           :n [150000 380000]}
                    :color "grey"
                    :size 2})
      (pj/lay-line {:data {:violation_desc-condensed ["Bus Only Zone" "Passenger Loading Zone"]
                           :n [150000 150000]}
                    :color "grey"
                    :size 2})
      (pj/lay-line {:data {:violation_desc-condensed 
                           ;["Bus Only Zone" "Passenger Loading Zone"]
                           [0 1]

                           :n [380000 380000]}
                    :color "grey"
                    :size 2})
      

      (pj/lay-label {:text :n
                     :nudge-y 10000
                     :color "black"})
      (pj/scale :y {:breaks ticks
                    :labels labels})
      (pj/scale :x {:domain all-values})

      (pj/coord :flip)
      (pj/options {:title "Number of tickets issued by Violation Description"
                   :x-label "Violation Description"
                   :y-label "Number of tickets issued"
