(defn draw-rectangle [[x-1 y-1] [x-2 y-2]]
  (->>
   (ui/path [x-1 y-1] [x-2 y-1] [x-2 y-2] [x-1 y-2] [x-1 y-1])
   (ui/with-color [0.5 0.5 0.5])
   (ui/with-style :membrane.ui/style-stroke))
  )
