  (scicloj.clay.v2.snippets/make-form-html! (quote (-> (rdatasets/reshape2-tips)
    (pj/lay-bar :day {:color :sex})
    ;(lay-rectangle :day :sex "Thur" "Fri" 40 60)
    ;; (pj/lay-text :day :sex {:text :text
    ;;                         :data {:day ["Fri" "Thur"]
    ;;                                :sex [40 40]
