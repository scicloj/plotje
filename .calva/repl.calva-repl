(def tickets (tc/dataset "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2019/2019-12-03/tickets.csv" {:key-fn keyword}))
(def tickets-condesed
  (-> tickets
      (tc/add-column :violation_desc-condensed 
                     (fn [ds]
                       (map
                        #(-> %
                             (str/replace #" CC$" "")
                             (str/trim)
                             (str/replace "STOPPING", "STOP")
                             (str/replace "HIWY", "HIGHWAY")
                             (str/replace #"PROH\\w+", "PROHIBITED")
                             (str/replace #"(PARK) PROHIBITED ", " PARKING ")
                             (str/replace "PASSENGR", "PASSENGER" )
                             (str/replace "LOADNG", "LOADING"))


                        (:violation_desc ds)
                        )
                       
                       ))
      ))
