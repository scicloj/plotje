clj꞉philadelfia-parking꞉> 
(def tickets-condensed
  (-> tickets
      (tc/add-column :violation_desc-condensed 
                     (fn [ds]
                       (-> 
                        (map
                         #(-> %
                              (str/replace #" CC$" "")
                              (str/trim)
                              (str/replace "STOPPING", "STOP")
                              (str/replace "HIWY", "HIGHWAY")
                              (str/replace #"PROH\w+", "PROHIBITED")
                              (str/replace #"(PARK) PROHIBITED ", " PARKING ")
                              (str/replace "PASSENGR", "PASSENGER" )
                              (str/replace "LOADNG", "LOADING")
                              (to-title)
                              
                              )


                         (:violation_desc ds)
                         )
                        (factor-lump 9)
                        )
                       
                       ))
      ))
