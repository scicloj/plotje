      (pj/lay-line {:data {:violation_desc-condensed ["Passenger Loading Zone" "Passenger Loading Zone"]
                           :n [150000 380000]}
                    :color "grey"
                    :size 2})
      (pj/lay-line {:data {:violation_desc-condensed ["Bus Only Zone" "Passenger Loading Zone"]
                           :n [150000 150000]}
                    :color "grey"
                    :size 2})
      (pj/lay-line {:data {:violation_desc-condensed ["Bus Only Zone" "Passenger Loading Zone"]
                           :n [380000 380000]}
                    :color "grey"
                    :size 2})
      

      (pj/lay-label {:text :n
                     :nudge-y 10000
                     :color "black"})
      (pj/scale :y {:breaks ticks
                    :labels labels})
      (pj/scale :x {:domain all-values})

      (pj/coord :flip)
      (pj/options {:title "Number of tickets issued by Violation Description"
                   :x-label "Violation Description"
                   :y-label "Number of tickets issued"
                   ;:palette ["grey" "red"]
                   :theme {:bg "green" :grid "blue" :font-size 10}}
                  )
      
      
      (pj/pose->draft)
      (pj/draft->membrane)
      (update :drawables
      
              (fn [uuuu]
                (let [drawables
                      [(ui/translate 300 250
                                     (ui/with-color [0.0 0.0 0.0]
                                       (ui/label "There appears to be different tiers of violations"
                                                 (ui/font nil 8))))
                       (ui/translate 300 260
                                     (ui/with-color [0.0 0.0 0.0]
                                       (ui/label "based upon the number of tickets issued"
                                                 (ui/font nil 8))))
                       (ui/translate 300 280
                                     (ui/with-color [0.0 0.0 0.0]
                                       (ui/label "'Meter Expired' is in a tier of its own.'"
                                                 (ui/font nil 8))))
                       (ui/translate 300 290
                                     (ui/with-color [0.0 0.0 0.0]
                                       (ui/label "'Parking Prohibited' ends the next tier."
                                                 (ui/font nil 8))))

                       (->> (ui/rounded-rectangle 25 12 3)
                            (ui/with-color [0 0 1])
                            (ui/translate 397 198))

                       (->> (ui/label "Hello"
                                      (ui/font nil 8))
                            (ui/with-color [0 0 0])
                            (ui/translate 400 200))


                       (->>
                        (ui/label "HELLO" (ui/font nil 15))
                        (ui/with-color [0 0 0])
                        (ui/translate 300 100))]]
                  (concat uuuu drawables))))
      (pj/membrane->plot :svg {})

      
      
      
      )) "/mnt/sdb3/sources/plotje/notebooks/philadelfia_parking.clj" {:ide :calva}))

