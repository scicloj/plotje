(def sorted-data
(-> tickets-condensed
    (tc/group-by :violation_desc-condensed)
    (tc/aggregate tc/row-count)
    (tc/order-by "summary")
    (tc/rename-columns {:$group-name :violation_desc-condensed
                        "summary" :n})
    (tc/add-column :highlite (fn [ds]
                               (map
                                #(if (= % "Parking Prohbited")
                                   "red"
                                   "grey")
                                (:violation_desc-condensed ds))))))
