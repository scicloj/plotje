    ;; (pj/lay-line :day :sex {:data {:day ["Fri" "Thur"]
    ;;                                :sex [10 40]
    ;;                                :text ["1. Line 1" "2. Line 2"]}})

    (pj/coord :flip)
    (pj/options {:title "Tips Count by Day and Gender"
                 :x-label "Day"
                 :y-label "Count"})
    

    (pj/pose->draft)
    (pj/draft->membrane)
    (update :drawables

            (fn [uuuu]
              (let [drawables
                    [(ui/translate 330 80
                                   (ui/with-color [0.0 0.0 0.0]
                                     (ui/label "1.line "
                                               (ui/font nil 8))))
                     (ui/translate 330 90
                                   (ui/with-color [0.0 0.0 0.0]
                                     (ui/label "2.line"
                                               (ui/font nil 8))))

                     (->> (ui/rectangle 50 30)
                          (ui/with-color [1 0 0 0.4])
                          (ui/translate 325 75))
                     
                     (->>
                      (ui/path [120 68] [200 200])
                      (ui/with-color [0 0 0])
                      (ui/with-style :membrane.ui/style-stroke)
                      )
                     ]]
                (concat uuuu drawables))))
    (pj/membrane->plot :svg {}))) "/mnt/sdb3/sources/plotje/notebooks/philadelfia_parking.clj" {:ide :calva}))

