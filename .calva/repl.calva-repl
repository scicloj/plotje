                         :data (-> sorted-data
                                   (tc/select-rows #(not (= "Parking Prohibited" (% :violation_desc-condensed)))))})

      (pj/lay-line {:data {:violation_desc-condensed ["Bus Only Zone" "Parking Prohibited"]
                           :n [300000 150000]}})
      
      (lay-rectangle :violation_desc-condensed :n
                     "Bus Only Zone" "Passenger Loading Zone"
                     150000 380000
                     )

      

      (pj/lay-label {:text :n
                     :nudge-y 10000
                     :color "black"})
      (pj/scale :y {:breaks ticks
                    :labels labels})
      (pj/scale :x {:domain all-values})

      (pj/coord :flip)
      (pj/options {:title "Number of tickets issued by Violation Description"
                   :x-label "Violation Description"
                   :y-label "Number of tickets issued"
                   ;:palette ["grey" "red"]
                   :theme {:bg "green" :grid "blue" :font-size 10}}
                  )
      
      
      (pj/pose->draft)
      (pj/draft->membrane)
      (update :drawables
      
              (fn [uuuu]
                (let [lines ["There appears to be different tiers of violations"
                             "based upon the number of tickets issued"
                             ""
                             "'Meter Expired' is in a tier of its own.'"
                             ""
                             "'Parking Prohibited' ends the next tier."]
                      drawables
                      (note-lines lines 300 250)
                      ]
                  (concat uuuu drawables))))
      (pj/membrane->plot :svg {}))) "/mnt/sdb3/sources/plotje/notebooks/philadelfia_parking.clj" {:ide :calva}))

