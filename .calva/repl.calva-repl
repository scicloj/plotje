(defn note-line [text y-offset-px top-x-px top-y-px]
  (->>
   (ui/label text
             (ui/font "hello" 8))
   (ui/with-color [0.0 0.0 0.0])
   (ui/translate top-x-px (+ y-offset-px top-y-px))))
