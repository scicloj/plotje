clj꞉philadelfia-parking꞉> 
(defn factor-lump [factor-seq n]
  (let  [to-keep (into #{} (->> factor-seq frequencies (sort-by second) reverse (take n) keys))]

    (map
     #(if (contains? to-keep %)
        %
        "other")
     factor-seq)))
