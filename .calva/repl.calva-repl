clj꞉philadelfia-parking꞉> 
(defn note-lines [lines top-x-px top-y-px px-witdh-per-char px-height-per-line]
  (let [longest-line (apply max (map count lines))
        n-lines (count lines)
        ]
    (conj
     (map-indexed
      #(note-line %2 (* %1 9) top-x-px top-y-px)
      lines)
     (draw-rectangle [top-x-px top-y-px] 
                     [(+ top-x-px (* longest-line px-witdh-per-char)) 
                      (+ top-y-px (* n-lines px-witdh-per-char))])
     ))
  )
