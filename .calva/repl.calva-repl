                               y [y-1 y-2]}
                        :color "grey"
                        :size 2})
      (pj/lay-line x y {:data {x [x-1 x-2]
                               y [y-1 y-1]}
                        :color "grey"
                        :size 2})
      (pj/lay-line x y {:data {x [x-1 x-2]
                               y [y-2 y-2]}
                        :color "grey"
                        :size 2})))
