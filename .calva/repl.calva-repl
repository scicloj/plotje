     (map-indexed
      #(note-line %2 (* %1 px-height-per-line) 
                  (+ top-x-px 1) 
                  (+ top-y-px 1))
      lines)
     (draw-rectangle [top-x-px top-y-px] 
                     [(+ top-x-px (* longest-line px-witdh-per-char)) 
                      (+ top-y-px (* n-lines px-height-per-line))])
     ))
  )
