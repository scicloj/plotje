;; plotje.edn -- Project-level configuration overrides.
;;
;; Copy this file to your project root as plotje.edn.
;; Only include keys you want to override -- everything else
;; falls back to the library defaults.
;;
;; Every value shown below is the library default, so a line you
;; uncomment and leave alone changes nothing.
;;
;; Precedence (highest wins):
;;   per-call options > with-config > set-config! > plotje.edn > library defaults
;;
;; A key Plotje does not read is reported when this file is loaded.
;; `(pj/config)` shows what resolved, and `pj/config-key-docs` lists
;; every key with a description.

{;; ---------- Layout ----------
 ;; Widths, heights and margins are in drawing units: one unit of the
 ;; plot's :width and :height.
 ;; :width 600
 ;; :height 400
 ;; :margin 10          ;; around single-panel plots
 ;; :margin-multi 10    ;; around multi-panel plots

 ;; ---------- Theme ----------
 ;; Visual identity: background, grid lines, font size.
 ;; Only include keys you want to change -- the rest are preserved.
 ;; :theme {:bg "#E8E8E8" :grid "#F5F5F5" :font-size 11}

 ;; ---------- Color ----------
 ;; The colors a categorical :color column is drawn in: a palette name,
 ;; a vector of colors, or a map from category to color. Over 7,000
 ;; named palettes are available via clojure2d.
 ;; :color-values :set1

 ;; The gradient a numeric :color column is read through: :sequential,
 ;; :diverging, a gradient name such as :inferno, a {:low :mid :high}
 ;; map, or a function.
 ;; :color-range :sequential

 ;; The value the middle of that gradient is drawn at, which centers a
 ;; diverging gradient there rather than halfway along the data.
 ;; :color-midpoint 0

 ;; Fallback color where no color mapping is set.
 ;; :default-color "#333"

 ;; ---------- Points ----------
 ;; :point-radius 3.0
 ;; :point-opacity 0.75

 ;; ---------- Bars and Lines ----------
 ;; :bar-opacity 0.85
 ;; :line-width 2.5

 ;; ---------- Behavior ----------
 ;; :validate true      ;; validate plans against Malli schema
 ;; :strict false       ;; when true, throw on unknown keys (typos like
 ;;                     ;; {:colour :species}) instead of warning
 }
